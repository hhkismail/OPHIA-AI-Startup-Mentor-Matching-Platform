# ── OPHIA ENV TEMPLATE ───────────────────────────────────────────────────────
# Copy this file to .env (in the repo root) and fill in the real values.
# Every module (nlp, data, backend, frontend) reads this one file.
# NEVER commit the actual .env file.

# Google Cloud Platform (Vertex AI embeddings + Gemini, Firestore)
# Auth: run `gcloud auth application-default login` once.
GCP_PROJECT_ID="your-gcp-project-id-here"
GCP_LOCATION="us-central1"

# Models — embeddings MUST be the same model everywhere, or similarity scores
# are meaningless. If you change EMBED_MODEL, re-run ophia-nlp/embed_data.py
# and ophia-data/seed_db.py.
EMBED_MODEL="text-embedding-004"
GEN_MODEL="gemini-3.1-flash-lite"

# Optional: Gemini API key (aistudio.google.com/apikey) used by embed_data.py
# for mentor generation. Leave empty to use Vertex AI for generation too.
GEMINI_API_KEY=""

# Firebase / Firestore — service-account key. If the file is missing,
# Application Default Credentials + GCP_PROJECT_ID are used instead.
FIREBASE_CREDENTIALS_PATH="./ophia-data/credentials/firebase-adminsdk.json"

# Google Workspace automation (Gmail, Drive, Calendar) — OAuth client file
WORKSPACE_CREDENTIALS_PATH="./ophia-data/credentials/workspace-credentials.json"
SENDER_EMAIL="your-gmail@gmail.com"

# Backend API server
HOST="0.0.0.0"
PORT=8000

# Frontend — where the Streamlit app finds the backend.
# Leave empty to run the frontend on built-in mock data (no backend needed).
OPHIA_API_URL=""
